# OrbitFlare last-hop ingest — proven defaults from the old capture box.
# Vendor sends shreds to PUBLIC_IP:UDP_PORT.

BIND_IP=0.0.0.0
UDP_PORT=20001

# Optional raw capture (lossy, off the RX path).
# CAPTURE_DIR=/data/captures/orbitflare
PREFIX=orbitflare
ROTATE_BYTES=2147483648
MIN_GB=40

# Isolated cores on the 48-core Frankfurt box were 47 / 46.
# CPU=47
# SINK_CPU=45
# REC_CPU=46

RCVBUF=16777216
RING=32768
BATCH=32
